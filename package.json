{
  "name": "tiddlywiki-community-editions",
  "version": "0.8.3",
  "private": true,
  "description": "TiddlyWiki community editions",
  "scripts": {
    "start": "tiddlywiki editions/recipes/wiki --listen host=0.0.0.0",
    "prebuild": "node scripts/reset-storylist.js",
    "build": "tiddlywiki editions/recipes/wiki --deletetiddlers \"[[$:/StoryList]]\" --build empty",
    "postbuild": "node scripts/reset-storylist.js && node scripts/embed-samples.js",
    "fetch-recipe": "node .meta/sandbox/recipes/scripts/fetch-recipe.js",
    "build-collection": "node .meta/sandbox/recipes/scripts/build-collection.js"
  },
  "devDependencies": {
    "tiddlywiki": "5.4.0"
  }
}
