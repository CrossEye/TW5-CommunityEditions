/* Recipe index tag filter */
.tc-recipe-filter {
    margin-bottom: 1em;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
}
.tc-recipe-tag-btn {
    padding: 0.2em 0.75em;
    border-radius: 2em;
    border: 1px solid <<colour primary>>;
    color: <<colour primary>>;
    font-size: 0.85em;
}
.tc-recipe-tag-active {
    background: <<colour primary>>;
    color: <<colour page-background>>;
}

/* Ingredient 'used in' panel */
.tc-recipe-ingredient-uses {
    margin-top: 1.5em;
    padding-top: 0.75em;
    border-top: 1px solid <<colour tiddler-border>>;
    font-size: 0.9em;
}
.tc-recipe-ingredient-uses ul {
    margin: 0.4em 0 0;
    padding-left: 1.5em;
}

/* Recipe metadata strip */
.tc-recipe-meta {
    margin: 0.25em 0 1.25em;
    font-size: 0.9em;
    color: <<colour muted-foreground>>;
}
.tc-recipe-source { margin-right: 1.5em; }

/* Recipe body layout */
.tc-recipe-split {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 2em;
}
.tc-recipe-split-left strong,
.tc-recipe-split-right strong {
    display: block;
    margin-bottom: 0.5em;
    font-size: 1.1em;
    border-bottom: 1px solid <<colour tiddler-border>>;
    padding-bottom: 0.25em;
}

/* Ingredients toggle button — hidden on wide screens, shown via media query on phones */
.tc-recipe-ingr-toggle {
    display: none;
}

/* Phone layout (<600px): single-column, ingredients collapsible */
@media (max-width: 599px) {
    .tc-recipe-split {
        grid-template-columns: 1fr;
    }
    .tc-recipe-ingr-panel {
        display: none;
        margin-bottom: 1em;
    }
    .tc-recipe-ingr-panel.tc-recipe-ingr-visible {
        display: block;
    }
    .tc-recipe-ingr-toggle {
        display: inline-block;
        font-size: 0.85em;
        border: 1px solid <<colour primary>>;
        border-radius: 1em;
        padding: 0.15em 0.6em;
        color: <<colour primary>>;
        white-space: nowrap;
    }
}

/* Step-by-step view */
.tc-stepview-header {
    text-align: center;
    margin-bottom: 1.5em;
}
.tc-stepview-progress {
    color: <<colour muted-foreground>>;
    margin-top: 0.25em;
    font-size: 0.9em;
}
.tc-step {
    display: block;
    width: 100%;
    text-align: left;
    cursor: pointer;
    padding: 0.5em 1em;
    border-left: 3px solid transparent;
    opacity: 0.6;
    font-size: 0.9em;
    line-height: 1.6;
    margin-bottom: 0.4em;
    transition: all 0.15s ease;
}
.tc-step-active {
    opacity: 1;
    font-size: 1.15em;
    border-left-color: <<colour primary>>;
    background: <<colour tiddler-background>>;
    border-radius: 3px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.12);
    padding: 0.75em 1em;
    margin: 0.4em 0;
}
.tc-stepview-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 2em;
    padding-top: 1em;
    border-top: 1px solid <<colour tiddler-border>>;
    color: <<colour muted-foreground>>;
    font-size: 0.9em;
    position: sticky;
    bottom: 0;
    background: <<colour tiddler-background>>;
    z-index: 10;
    padding-bottom: 0.75em;
}

/* Cooking-mode active: hide distractions, boost legibility */
<$list filter="[[$:/state/community/recipes/cooking-mode]get[text]!is[blank]]">
.tc-subtitle,
.tc-tags-wrapper {
    display: none;
}
.tc-tiddler-controls button:not(.tc-recipe-cooking-mode-btn) {
    display: none;
}
.tc-recipe-split {
    font-size: 1.15em;
    padding-bottom: 4em;
}
.tc-stepview-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.75em 1.5em;
    margin-top: 0;
    border-top: 1px solid <<colour tiddler-border>>;
    box-shadow: 0 -2px 6px rgba(0,0,0,0.08);
}
</$list>
