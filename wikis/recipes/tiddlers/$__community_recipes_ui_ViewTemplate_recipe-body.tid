title: $:/community/recipes/ui/ViewTemplate/recipe-body

\whitespace trim
<$let stepState={{{ [[$:/state/community/recipes/step/]addsuffix<currentTiddler>] }}}
     ingrState={{{ [[$:/state/community/recipes/ingr/]addsuffix<currentTiddler>] }}}
     ingreds={{{ [<currentTiddler>get[text]splitregexp[!! Ingredients]last[]splitregexp[!! ]first[]] }}}
     stepCount={{{ [<currentTiddler>get[text]splitregexp[!! Steps]last[]splitregexp[!! ]first[]splitregexp[\r?\n]regexp[^# ]removeprefix[# ]trim[]count[]] }}}>
<$set name="stepIdx" tiddler=<<stepState>> field="text" emptyValue="1">
<$set name="ingrVisible" tiddler=<<ingrState>> field="text" emptyValue="hide">

<div class="tc-stepview-header">
<div class="tc-stepview-progress">Step&#32;<<stepIdx>>&#32;of&#32;<<stepCount>></div>
</div>

<div class="tc-recipe-split">
<div class={{{ [<ingrVisible>match[show]then[tc-recipe-split-left tc-recipe-ingr-panel tc-recipe-ingr-visible]else[tc-recipe-split-left tc-recipe-ingr-panel]] }}}>
<strong>Ingredients</strong>
<$transclude $variable="ingreds" $mode="block"/>
</div>
<div class="tc-recipe-split-right">
<$list filter="[<currentTiddler>get[text]splitregexp[!! Steps]last[]splitregexp[!! ]first[]splitregexp[\r?\n]regexp[^# ]removeprefix[# ]trim[]]" variable="stepText" counter="stepNum">
<$button class={{{ [<stepNum>match<stepIdx>then[tc-step tc-step-active tc-btn-invisible]else[tc-step tc-btn-invisible]] }}}>
<$action-setfield $tiddler=<<stepState>> text=<<stepNum>>/>
<$transclude $variable="stepText" $mode="inline"/>
</$button>
</$list>
</div>
</div>

<div class="tc-stepview-nav">
<%if [<stepIdx>!match[1]] %>
<$button>
<$action-setfield $tiddler=<<stepState>> text={{{ [<stepIdx>subtract[1]] }}}/>
← Previous
</$button>
<% else %>
<span></span>
<% endif %>
<span><<stepIdx>>&#32;/&#32;<<stepCount>></span>
<$button class="tc-btn-invisible tc-recipe-ingr-toggle">
<$action-setfield $tiddler=<<ingrState>> text={{{ [<ingrVisible>match[show]then[hide]else[show]] }}}/>
<%if [<ingrVisible>match[show]] %>▴&#32;Ingredients<% else %>▾&#32;Ingredients<% endif %>
</$button>
<%if [<stepIdx>!match<stepCount>] %>
<$button>
<$action-setfield $tiddler=<<stepState>> text={{{ [<stepIdx>add[1]] }}}/>
Next →
</$button>
<% else %>
<span></span>
<% endif %>
</div>

</$set>
</$set>
</$let>
