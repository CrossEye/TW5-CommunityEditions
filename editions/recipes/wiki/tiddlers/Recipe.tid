caption: All Recipes
tags: TableOfContents
title: Recipe
type: text/vnd.tiddlywiki

\whitespace trim
<$let activeTag={{$:/state/community/recipes/filter-tag}}>
<div class="tc-recipe-filter">
<$list filter="[tag[Recipe]!is[system]tags[]!match[Recipe]!prefix[$:/]sort[]]" variable="cat">
<$button class={{{ [<cat>match<activeTag>then[tc-btn-invisible tc-recipe-tag-btn tc-recipe-tag-active]else[tc-btn-invisible tc-recipe-tag-btn]] }}}>
<$action-setfield $tiddler="$:/state/community/recipes/filter-tag" text={{{ [<cat>match<activeTag>then[]else<cat>] }}}/>
<<cat>>
</$button>
</$list>
</div>
<%if [<activeTag>match[]] %>
<%if [tag[Recipe]!is[system]] %>
<ul><$list filter="[tag[Recipe]!is[system]sort[title]]">
<li><$link/></li>
</$list></ul>
<%else%>
<<t AllRecipes/EmptyAll>>
<%endif%>
<% else %>
<%if [tag[Recipe]!is[system]tag<activeTag>] %>
<ul><$list filter="[tag[Recipe]!is[system]tag<activeTag>sort[title]]">
<li><$link/></li>
</$list></ul>
<%else%>
<$let tag=<<activeTag>>><<t AllRecipes/EmptyTaggedFormat>></$let>
<%endif%>
<% endif %>
</$let>
