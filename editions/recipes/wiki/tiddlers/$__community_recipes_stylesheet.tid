/* Recipe index tag filter */
.tc-recipe-filter {
    margin-bottom: 1em;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
}
.tc-recipe-tag-btn {
    padding: 0.2em 0.75em;
    border-radius: 2em;
    border: 1px solid <<colour primary>>;
    color: <<colour primary>>;
    font-size: 0.85em;
}
.tc-recipe-tag-active {
    background: <<colour primary>>;
    color: <<colour page-background>>;
}

/* Ingredient photo (float left, mirroring recipe's float right) */
.tc-ingredient-photo {
    float: left;
    margin: 0 1.5em 0.75em 0;
    max-width: 35%;
}
.tc-ingredient-photo img {
    max-width: 100%;
    border-radius: 4px;
}
.tc-ingredient-clear {
    clear: both;
}

/* Alias notice — shown when viewing an alias tiddler */
.tc-ingredient-alias-notice {
    margin: 0 0 1em;
    padding: 0.4em 0.9em;
    border-left: 3px solid <<colour primary>>;
    color: <<colour muted-foreground>>;
    font-style: italic;
}

/* "Also known as" line on canonical ingredient */
.tc-ingredient-aliases {
    margin-top: 0.25em;
    font-size: 0.9em;
    color: <<colour muted-foreground>>;
}

/* Ingredient/used-in footer panel */
.tc-recipe-ingredient-uses {
    margin-top: 1.5em;
    padding-top: 0.75em;
    border-top: 1px solid <<colour tiddler-border>>;
    font-size: 0.9em;
}
.tc-recipe-ingredient-uses ul {
    margin: 0.4em 0 0;
    padding-left: 1.5em;
}

@media (max-width: 599px) {
    .tc-ingredient-photo {
        float: none;
        max-width: 100%;
        margin: 0 0 1em;
    }
}

/* Recipe metadata strip */
.tc-recipe-meta {
    margin: 0.25em 0 1.25em;
    font-size: 0.9em;
    color: <<colour muted-foreground>>;
}
.tc-recipe-source { margin-right: 1.5em; }

/* Recipe body layout */
.tc-recipe-split {
    clear: both;
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 2em;
}
.tc-recipe-split-left strong,
.tc-recipe-split-right strong {
    display: block;
    margin-bottom: 0.5em;
    font-size: 1.1em;
    border-bottom: 1px solid <<colour tiddler-border>>;
    padding-bottom: 0.25em;
}

/* Ingredients toggle button — cooking-mode only; visual styling kept here */
.tc-recipe-ingr-toggle {
    display: none;
    font-size: 0.85em;
    border: 1px solid <<colour primary>>;
    border-radius: 1em;
    padding: 0.15em 0.6em;
    color: <<colour primary>>;
    white-space: nowrap;
}

/* Phone layout (<600px): single-column; ingredients always visible in normal mode */
@media (max-width: 599px) {
    .tc-recipe-split {
        grid-template-columns: 1fr;
    }
}

/* About block and photo */
.tc-recipe-about {
    margin-bottom: 1.5em;
}
.tc-recipe-photo {
    float: right;
    margin: 0 0 0.75em 1.5em;
    max-width: 40%;
}
.tc-recipe-photo img {
    max-width: 100%;
    border-radius: 4px;
}

/* Step-by-step view */
.tc-stepview-header {
    text-align: center;
    margin-bottom: 1.5em;
}
.tc-stepview-progress {
    color: <<colour muted-foreground>>;
    margin-top: 0.25em;
    font-size: 0.9em;
}
.tc-step-num {
    font-weight: bold;
    margin-right: 0.2em;
}

.tc-step {
    display: block;
    width: 100%;
    text-align: left;
    cursor: pointer;
    padding: 0.5em 1em;
    border-left: 3px solid transparent;
    opacity: 0.6;
    font-size: 0.9em;
    line-height: 1.6;
    margin-bottom: 0.4em;
    transition: all 0.15s ease;
}
.tc-step-active {
    opacity: 1;
    font-size: 1.15em;
    border-left-color: <<colour primary>>;
    background: <<colour tiddler-background>>;
    border-radius: 3px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.12);
    padding: 0.75em 1em;
    margin: 0.4em 0;
}
.tc-stepview-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: <<colour muted-foreground>>;
    font-size: 1.125em;
    background: <<colour tiddler-background>>;
}

/* Photo section in edit templates */
.tc-recipe-photo-edit-section {
    margin: 0 0 1em;
    padding: 0.75em 1em;
    border: 1px solid <<colour tiddler-border>>;
    border-radius: 4px;
}
.tc-recipe-photo-edit-section > strong {
    display: block;
    margin-bottom: 0.75em;
}
.tc-recipe-photo-edit-preview {
    display: flex;
    gap: 1em;
}
.tc-recipe-photo-preview-thumb {
    flex: 0 0 120px;
}
.tc-recipe-photo-preview-thumb img {
    width: 100%;
    height: 100%;
    border-radius: 3px;
    object-fit: cover;
    display: block;
}
.tc-recipe-photo-edit-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    min-width: 0;
}
.tc-recipe-photo-or {
    color: <<colour muted-foreground>>;
    font-size: 0.9em;
}
.tc-recipe-photo-form {
    margin-top: 0.75em;
}
.tc-recipe-photo-form-preview {
    margin-bottom: 0.75em;
}
.tc-recipe-photo-form-preview img {
    max-width: 200px;
    max-height: 150px;
    border-radius: 3px;
    object-fit: cover;
}
.tc-recipe-photo-form-image-row {
    display: flex;
    align-items: center;
    gap: 0.75em;
    flex-wrap: wrap;
    margin-bottom: 0.75em;
}
.tc-recipe-photo-form-image-row input {
    flex: 1;
    min-width: 150px;
}
.tc-recipe-photo-form-field {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
    margin-bottom: 0.5em;
}
.tc-recipe-photo-form-field label {
    font-size: 0.85em;
    color: <<colour muted-foreground>>;
}
.tc-recipe-photo-form-field input {
    width: 100%;
    box-sizing: border-box;
}
.tc-recipe-photo-form-actions {
    display: flex;
    gap: 0.5em;
    margin-top: 0.75em;
    justify-content: flex-end;
}
.tc-recipe-photo-save-btn {
    background: <<colour primary>>;
    color: <<colour page-background>>;
    border-color: <<colour primary>>;
}

/* Cooking-mode active: hide distractions, boost legibility */
<$list filter="[[$:/state/community/recipes/cooking-mode]get[text]!is[blank]]">
.tc-subtitle,
.tc-tags-wrapper {
    display: none;
}
.tc-tiddler-controls button:not(.tc-recipe-cooking-mode-btn) {
    display: none;
}
.tc-hide-sidebar-btn,
.tc-show-sidebar-btn {
    display: none;
}
@media (max-width: 599px) {
    .tc-recipe-ingr-panel {
        display: none;
        margin-bottom: 1em;
    }
    .tc-recipe-ingr-panel.tc-recipe-ingr-visible {
        display: block;
    }
    .tc-recipe-ingr-toggle {
        display: inline-block;
    }
}
.tc-recipe-about {
    display: none;
}
.tc-recipe-split {
    font-size: 1.15em;
    padding-bottom: 4em;
}
.tc-stepview-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.75em 1.5em;
    margin-top: 0;
    border-top: 1px solid <<colour tiddler-border>>;
    box-shadow: 0 -2px 6px rgba(0,0,0,0.08);
}
/* Edge-to-edge: remove page chrome around the tiddler */
.tc-story-river {
    padding: 0 !important;
}
.tc-tiddler-frame {
    margin: 0 !important;
    border-radius: 0;
    box-shadow: none;
    min-height: 100vh;
}
body {
    background-color: <<colour tiddler-background>>;
}
</$list>
