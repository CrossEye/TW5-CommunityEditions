caption: Common Ingredients
created: 20260427220000001
icon: $:/community/recipes/images/recipe-box-card/ingredients
modified: 20260428035836511
tags: $:/tags/community/recipes/recipe-box-card
title: $:/community/recipes/recipe-box-card/popular-ingredients
type: text/vnd.tiddlywiki

\whitespace trim
<$let photosMode={{{ [[$:/config/community/recipes/photos]get[text]!is[blank]] ~[[own]] }}}
     limit={{{ [<isActive>match[expanded]then[10]else[3]] }}}>
<%if [tag[Ingredient]] %>
<%if [<photosMode>!match[none]] %>
<div class="tc-recipe-box-tiles">
<$list filter="[tag[Ingredient]] :sort:number[backlinks[]tag[Recipe]count[]] +[reverse[]first<limit>]">
<$let photo={{{ [<currentTiddler>get[photo]] }}}>
<$link class="tc-recipe-box-tile">
<$list filter="[<photo>!is[blank]]" variable="ignore" emptyMessage="<span class='tc-recipe-box-tile-photo tc-recipe-box-tile-photo-placeholder'>{{$:/community/recipes/images/photo-placeholder}}</span>">
<span class="tc-recipe-box-tile-photo"><$transclude $tiddler=<<photo>> $mode="block"/></span>
</$list>
<span class="tc-recipe-box-tile-title"><<currentTiddler>></span>
</$link>
</$let>
</$list>
</div>
<%else%>
<ul class="tc-recipe-box-link-list">
<$list filter="[tag[Ingredient]] :sort:number[backlinks[]tag[Recipe]count[]] +[reverse[]first<limit>]">
<li><$link to=<<currentTiddler>>><<currentTiddler>></$link></li>
</$list>
</ul>
<%endif%>
<%else%>
<div class="tc-recipe-box-empty">//<<t RecipeBoxCard/PopularIngredients/Empty>>//</div>
<%endif%>
</$let>
