list-after: $:/core/ui/ViewTemplate/body
tags: $:/tags/ViewTemplate
title: $:/community/recipes/ui/ViewTemplate/ingredient
type: text/vnd.tiddlywiki

\whitespace trim
<% if [all[current]tag[Ingredient]] %>
<% if [<currentTiddler>has[aliases]] %>
<hr/>
<div class="tc-ingredient-aliases">
<<t Ingredient/AlsoKnownAs>>&nbsp;<$list filter="[<currentTiddler>get[aliases]enlist-input[]sort[]]" join=", "><$link/></$list>
</div>
<% endif %>
<% if [<currentTiddler>backlinks[]tag[Recipe]] [<currentTiddler>get[aliases]enlist-input[]backlinks[]tag[Recipe]] %>
<hr/>
<div class="tc-recipe-ingredient-uses">
<h3><<t Ingredient/RecipesUsing>> <span class="ingredient">&nbsp;<$view field="title"/></span>:</h3>
<ul>
<$list filter="[<currentTiddler>backlinks[]tag[Recipe]] [<currentTiddler>get[aliases]enlist-input[]backlinks[]tag[Recipe]] +[sort[title]]">
<li><$link/></li>
</$list>
</ul>
</div>
<% endif %>
<% endif %>
<% if [all[current]!tag[Ingredient]] %>
<% if [<currentTiddler>!is[tiddler]] %>
<$list filter="[tag[Ingredient]contains:aliases<currentTiddler>first[]]">
<h3><<t Ingredient/AliasOf>> &nbsp; <$link/></h3>
</$list>
<% endif %>
<% if [<currentTiddler>backlinks[]tag[Recipe]] %>
<div class="tc-recipe-ingredient-uses">
<h3><<t Ingredient/UsedIn>></h3>
<ul>
<$list filter="[<currentTiddler>backlinks[]tag[Recipe]sort[title]]">
<li><$link/></li>
</$list>
</ul>
</div>
<% endif %>
<% endif %>
