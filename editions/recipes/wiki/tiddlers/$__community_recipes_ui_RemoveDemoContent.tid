<td><$list filter="[<t>get[photo]!is[blank]]" variable="photoTitle"><$checkbox tiddler={{{ [[$:/state/community/recipes/remove-demo/]addsuffix<photoTitle>] }}} field="text" checked="yes" unchecked="no" default="yes"/></$list></td>
