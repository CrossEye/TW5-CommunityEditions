!! Remove these Recipes

<table class="tc-remove-demo-table">
<thead><tr>
<th><$checkbox tiddler="$:/state/community/recipes/remove-demo-section/recipes" field="text" checked="yes" unchecked="no" default="yes" checkactions=<<check-all-recipes>> uncheckactions=<<uncheck-all-recipes>>/></th>
<th>Recipe</th>
</tr></thead>
<tbody>
<$list filter="[field:demo[yes]tag[Recipe]!title[Basic Pancakes]sort[title]]" variable="recipeTitle">
<tr>
<td><$checkbox tiddler={{{ [[$:/state/community/recipes/remove-demo/]addsuffix<recipeTitle>] }}} field="text" checked="yes" unchecked="no" default="yes"/></td>
<td><$link to=<<recipeTitle>>/></td>
</tr>
<$list filter="[<recipeTitle>get[photo]!is[blank]]" variable="photoTitle">
<tr>
<td><$checkbox tiddler={{{ [[$:/state/community/recipes/remove-demo/]addsuffix<photoTitle>] }}} field="text" checked="yes" unchecked="no" default="yes"/></td>
<td><$link to=<<photoTitle>>/></td>
</tr>
</$list>
</$list>
</tbody>
</table>

<$list filter="[field:demo[yes]tag[Ingredient]limit[1]]" variable="ignore">

