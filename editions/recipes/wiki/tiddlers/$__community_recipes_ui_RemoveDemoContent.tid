\define check-all-recipes()
<$list filter="[field:demo[yes]tag[Recipe]!title[Basic Pancakes]]" variable="t">
<$action-setfield $tiddler={{{ [[$:/state/community/recipes/remove-demo/]addsuffix<t>] }}} text="yes"/>
<$list filter="[<t>get[photo]!is[blank]]" variable="p">
<$action-setfield $tiddler={{{ [[$:/state/community/recipes/remove-demo/]addsuffix<p>] }}} text="yes"/>
</$list>
</$list>
\end
\define uncheck-all-recipes()
<$list filter="[field:demo[yes]tag[Recipe]!title[Basic Pancakes]]" variable="t">
<$action-setfield $tiddler={{{ [[$:/state/community/recipes/remove-demo/]addsuffix<t>] }}} text="no"/>
<$list filter="[<t>get[photo]!is[blank]]" variable="p">
<$action-setfield $tiddler={{{ [[$:/state/community/recipes/remove-demo/]addsuffix<p>] }}} text="no"/>
</$list>
</$list>
\end
