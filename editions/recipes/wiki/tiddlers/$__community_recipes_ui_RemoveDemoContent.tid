!! Remove these Recipes

<table class="tc-remove-demo-table">
<thead><tr>
<th>Name</th>
<th><$checkbox tiddler="$:/state/community/recipes/remove-demo-section/recipes" field="text" checked="yes" unchecked="no" default="yes" checkactions=<<check-all-recipes>> uncheckactions=<<uncheck-all-recipes>>/> Recipe</th>
<th><$checkbox tiddler="$:/state/community/recipes/remove-demo-section/recipe-photos" field="text" checked="yes" unchecked="no" default="yes" checkactions=<<check-all-recipe-photos>> uncheckactions=<<uncheck-all-recipe-photos>>/> Photo</th>
</tr></thead>
<tbody>
<$list filter="[field:demo[yes]tag[Recipe]!title[Basic Pancakes]sort[title]]" variable="recipeTitle">
<tr>
<td><$link to=<<recipeTitle>>/></td>
<td><$checkbox tiddler={{{ [[$:/state/community/recipes/remove-demo/]addsuffix<recipeTitle>] }}} field="text" checked="yes" unchecked="no" default="yes"/></td>
<td><$list filter="[<recipeTitle>get[photo]!is[blank]]" variable="photoTitle"><$checkbox tiddler={{{ [[$:/state/community/recipes/remove-demo/]addsuffix<photoTitle>] }}} field="text" checked="yes" unchecked="no" default="yes"/></$list></td>
</tr>
</$list>
</tbody>
</table>

<$list filter="[field:demo[yes]tag[Ingredient]limit[1]]" variable="ignore">

