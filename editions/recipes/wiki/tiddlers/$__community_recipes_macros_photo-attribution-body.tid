tags: $:/tags/Global
title: $:/community/recipes/macros/photo-attribution-body

\procedure photo-attribution-body()
\whitespace trim
<summary><<t PhotoAttribution/Summary>></summary>
<div class="tc-recipe-photo-form-field">
<label><<t PhotoAttribution/PhotographerLabel>></label>
<$edit-text tiddler=<<photographerState>> field="text" placeholder=<<t PhotoAttribution/PhotographerPlaceholder>> default="" tag="input"/>
</div>
<div class="tc-recipe-photo-form-field">
<label><<t PhotoAttribution/PhotoSourceLabel>></label>
<$edit-text tiddler=<<photoSourceState>> field="text" placeholder=<<t PhotoAttribution/PhotoSourcePlaceholder>> default="" tag="input"/>
</div>
<div class="tc-recipe-photo-form-field">
<label><<t PhotoAttribution/SourceNameLabel>></label>
<$edit-text tiddler=<<sourceNameState>> field="text" placeholder=<<t PhotoAttribution/SourceNamePlaceholder>> default="" tag="input"/>
</div>
\end
