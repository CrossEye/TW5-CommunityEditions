list-after: $:/core/ui/ViewTemplate/tags
tags: $:/tags/ViewTemplate
title: $:/community/recipes/ui/ViewTemplate/recipe-meta
type: text/vnd.tiddlywiki

\import [tag[$:/tags/community/recipes/procedure]]
\whitespace trim
<%if [all[current]tag[Recipe]] %>
<div class="tc-recipe-meta">
<$list filter="[all[shadows+tiddlers]tag[$:/tags/community/recipes/extra-field]]" variable="extraFieldConfig">
<$let fieldName={{{ [<extraFieldConfig>get[field-name]] }}}
      caption={{{ [<extraFieldConfig>get[caption]] }}}
      bodyText={{{ [<extraFieldConfig>get[text]] }}}>
<%if [<currentTiddler>get<fieldName>!is[blank]] %>
<$let field-value={{{ [<currentTiddler>get<fieldName>] }}}>
<div class="tc-recipe-extra-field">
<span class="tc-recipe-extra-field-caption"><<caption>></span>:&nbsp;<%if [<bodyText>!is[blank]] %><$transclude tiddler=<<extraFieldConfig>>/><%else%><<extra-field-default>><%endif%>
</div>
</$let>
<%endif%>
</$let>
</$list>
</div>
<% endif %>
